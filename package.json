{
  "name": "Validose",
  "main": "expo-router/entry",
  "version": "1.0.1-build.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "ENV_FILE=.env.development expo start",
    "start:staging": "ENV_FILE=.env.staging expo start",
    "start:prod": "ENV_FILE=.env.production expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:dev": "ENV_FILE=.env.development expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "ENV_FILE=.env.development expo run:ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "prepare": "husky install",
    "expo-lint": "expo lint",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint-fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "prettier": "prettier . --write",
    "ci:checks": "npm run lint && npm run test",
    "version:build:show": "node ./scripts/release/bump-build-number.mjs --show",
    "version:build:bump": "node ./scripts/release/bump-build-number.mjs --bump",
    "version:build:set": "node ./scripts/release/bump-build-number.mjs --set",
    "build:android": "npm run build:android:production:local",
    "build:ios": "npm run build:ios:production",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:production": "eas build --platform ios --profile production",
    "build:android:production:local": "eas build --platform android --profile production-apk --local --output ./build/android-release.apk",
    "submit:android:production": "eas submit --platform android --profile production",
    "submit:ios:production": "eas submit --platform ios --profile production",
    "release:android:production": "eas build --platform android --profile production --auto-submit",
    "release:ios:production": "eas build --platform ios --profile production --auto-submit",
    "deploy:android:develop": "npm run build:android:preview",
    "deploy:ios:develop": "npm run build:ios:preview",
    "deploy:develop": "npm run ci:checks && npm run build:android:preview && npm run build:ios:preview"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.4",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.16",
    "@tanstack/react-query": "^5.74.4",
    "axios": "^1.8.4",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "expo": "~52.0.47",
    "expo-asset": "~11.0.5",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "^0.13.3",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.8",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-linking": "~7.0.5",
    "expo-localization": "~16.0.1",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.21",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.1",
    "expo-symbols": "~0.2.2",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.2",
    "jwt-decode": "^4.0.0",
    "moment-timezone": "^0.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.55.0",
    "react-native": "^0.76.9",
    "react-native-device-info": "^14.0.4",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-get-random-values": "^1.11.0",
    "react-native-paper": "^5.13.3",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-tenx-mdk-ble": "file:modules/tenx-mdk-ble-rn-library",
    "react-native-toast-message": "^2.3.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "latest",
    "@tanstack/eslint-plugin-query": "^5.73.3",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-define": "^2.1.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.6",
    "prettier": "^3.5.3",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.8.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css,scss}": [
      "prettier . --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings 0 ."
    ]
  },
  "private": true
}
