# ------------------------------
# Shared
# ------------------------------
CI=true
FASTLANE_SKIP_UPDATE_CHECK=1
# Optional compile-time env file consumed by babel.config.js
# ENV_FILE=build/env/.env.stage
APP_ENV=stage
RELEASE_LABEL=stage-develop-123
# Optional release notes source (preferred in CI)
# RELEASE_NOTES_FILE=build/metadata/release-notes.md
# Fallback plain text release notes
# RELEASE_NOTES=Short manual notes here

# ------------------------------
# Android
# ------------------------------
ANDROID_APPLICATION_ID=com.anonymous.x10xbetamobilemdkpoc
ANDROID_TRACK=internal
ANDROID_RELEASE_STATUS=completed
ANDROID_UPLOAD_TO_STORE=true
PLAY_STORE_RELEASE_NOTES_LOCALE=en-US
# Max chars for Play release notes
ANDROID_RELEASE_NOTES_MAX_CHARS=500
# Optional override. If unset, Fastlane resolves from Google Play (or BUILD_NUMBER fallback).
# ANDROID_VERSION_CODE=123
# Optional override used by Gradle when set.
# ANDROID_VERSION_NAME=1.0.0

# Jenkins file credential -> absolute path exposed at runtime
ANDROID_KEYSTORE_PATH=/absolute/path/to/validose-release-key.keystore
VALIDOSE_RELEASE_KEY_ALIAS=your-alias
VALIDOSE_RELEASE_STORE_PASSWORD=replace-me
VALIDOSE_RELEASE_KEY_PASSWORD=replace-me
PLAY_STORE_JSON_KEY=/absolute/path/to/google-play-service-account.json

# ------------------------------
# iOS
# ------------------------------
IOS_APP_IDENTIFIER=com.10xbeta.validose
IOS_SCHEME=validosemobileapp
IOS_WORKSPACE=ios/validosemobileapp.xcworkspace
IOS_UPLOAD_TO_STORE=true
# Optional override. If unset, Fastlane resolves from TestFlight (or BUILD_NUMBER fallback).
# IOS_BUILD_NUMBER=123
# When IOS_UPLOAD_TO_STORE=false and no App Store API key is configured, set IOS_BUILD_NUMBER explicitly.
IOS_CHANGELOG_MAX_CHARS=3900

APP_STORE_CONNECT_KEY_ID=replace-me
APP_STORE_CONNECT_ISSUER_ID=replace-me
APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXX.p8

# Match is optional but strongly recommended for reproducible code signing in CI.
# If omitted, Jenkins macOS node must already have valid signing certs/profiles installed.
MATCH_GIT_URL=git@github.com:your-org/ios-certificates.git
MATCH_GIT_BASIC_AUTHORIZATION=base64-encoded-git-user-and-token
MATCH_PASSWORD=replace-me
MATCH_READONLY=true

DEVELOPER_PORTAL_TEAM_ID=34K9KC69F2
# Optional for Appfile metadata
# APP_STORE_CONNECT_TEAM_ID=123456789
# APPLE_ID=name@example.com
