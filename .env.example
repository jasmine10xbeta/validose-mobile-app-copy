# Copy this file to one or more of:
# - .env.development
# - .env.staging
# - .env.production
#
# Then set ENV_FILE to choose which file Babel uses for compile-time env replacement.

BASE_URL=https://api.stg.aws.validose.com
API_AWS_PROJECT_REGION=us-east-1
API_AWS_USER_POOLS_ID=us-east-1_xxxxxxxxx
API_AWS_USER_POOLS_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
SHOW_LOGS=false
DEVICE_ID=

# Hidden BLE bypass
ENABLE_BLE_BYPASS=false
BLE_BYPASS_MODE=false
BLE_BYPASS_KEY=

# Optional Expo-public aliases (if needed by runtime)
EXPO_PUBLIC_ENABLE_BLE_BYPASS=false
EXPO_PUBLIC_BLE_BYPASS_MODE=false
EXPO_PUBLIC_BLE_BYPASS_KEY=
